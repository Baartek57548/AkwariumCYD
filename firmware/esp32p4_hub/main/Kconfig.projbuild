menu "AquaHub ESP32-P4"

config AQUAHUB_LOCAL_BROKER
    bool "Run the local MQTTS broker on ESP32-P4"
    default y

config AQUAHUB_MQTT_BROKER_PORT
    int "Local MQTTS broker port"
    range 1024 65535
    default 8883
    depends on AQUAHUB_LOCAL_BROKER

config AQUAHUB_API_PORT
    int "Local HTTPS API port"
    range 1024 65535
    default 8443

config AQUAHUB_CORS_ORIGIN
    string "Exact HTTPS origin allowed for the Flutter web client"
    default ""
    help
        Leave empty to disable cross-origin browser access. Never use '*'.
        Example: https://panel.example.lan

config AQUAHUB_OTA_ENABLED
    bool "Enable the verified HTTPS OTA state machine"
    default y
    help
        Enables A/B firmware download, SHA-256 verification and rollback
        support. The feature remains unavailable at runtime until an HTTPS
        base URL is configured. Secure Boot v2 provides production image
        authenticity after per-device eFuse provisioning.

config AQUAHUB_OTA_BASE_URL
    string "HTTPS base URL containing manifest.json and firmware images"
    default ""
    depends on AQUAHUB_OTA_ENABLED
    help
        Example: https://releases.example.com/aquahub/stable
        Redirects and arbitrary URLs supplied by API clients are rejected.

config AQUAHUB_OTA_HTTP_TIMEOUT_MS
    int "OTA HTTPS operation timeout in milliseconds"
    range 5000 120000
    default 30000
    depends on AQUAHUB_OTA_ENABLED

config AQUAHUB_OTA_REBOOT_DELAY_MS
    int "Delay before reboot after a verified update"
    range 1000 30000
    default 5000
    depends on AQUAHUB_OTA_ENABLED

config AQUACYD_HMI_WIFI_SSID
    string "2.4 GHz Wi-Fi SSID"
    default ""

config AQUACYD_HMI_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config AQUACYD_HMI_MQTT_BROKER_URI
    string "External MQTT broker URI (ignored with local broker)"
    default "mqtt://homeassistant.local:1883"

config AQUACYD_HMI_MQTT_USERNAME
    string "MQTT username (minimum 4 characters)"
    default ""

config AQUACYD_HMI_MQTT_PASSWORD
    string "MQTT password (minimum 12 characters)"
    default ""

config AQUACYD_HMI_MQTT_BASE_TOPIC
    string "AquaCYD MQTT base topic"
    default "aquacyd/aquarium"

config AQUACYD_HMI_ROTATE_180
    bool "Rotate display by 180 degrees"
    default y

endmenu
