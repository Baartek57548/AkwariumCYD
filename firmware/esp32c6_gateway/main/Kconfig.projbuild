menu "AquaCYD ESP32-C6 gateway"

config AQUACYD_WIFI_SSID
    string "2.4 GHz Wi-Fi SSID"
    default ""

config AQUACYD_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config AQUACYD_MQTT_BROKER_URI
    string "MQTT broker URI"
    default "mqtts://aquahub.local:8883"

config AQUACYD_MQTT_EMBED_HUB_CERTIFICATE
    bool "Embed the verified AquaHub TLS certificate"
    default n
    help
        Requires main/aquahub.pem generated with tools/pin-aquahub-certificate.ps1.
        The gateway refuses mqtts:// connections when this option is disabled.

config AQUACYD_MQTT_USERNAME
    string "MQTT username"
    default ""

config AQUACYD_MQTT_PASSWORD
    string "MQTT password"
    default ""

config AQUACYD_MQTT_BASE_TOPIC
    string "MQTT base topic"
    default "aquacyd/aquarium"

config AQUACYD_DEVICE_ID
    string "Home Assistant device identifier"
    default "aquacyd_aquarium"

config AQUACYD_CONTROLLER_MAC
    string "CYD Wi-Fi MAC address"
    default "00:00:00:00:00:00"

config AQUACYD_ESPNOW_PMK
    string "ESP-NOW PMK as 32 hexadecimal characters"
    default ""

config AQUACYD_ESPNOW_LMK
    string "ESP-NOW LMK as 32 hexadecimal characters"
    default ""

config AQUACYD_CONTROLLER_OFFLINE_TIMEOUT_SECONDS
    int "Controller offline timeout in seconds"
    range 5 300
    default 15

endmenu
