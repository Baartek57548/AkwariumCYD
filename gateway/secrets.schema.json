{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquacyd.local/schemas/gateway-secrets-v1.json",
  "title": "AquaCYD gateway secrets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "devices"
  ],
  "properties": {
    "devices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{4,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hmacSecret",
          "viewerTokenSha256"
        ],
        "properties": {
          "hmacSecret": {
            "type": "string",
            "pattern": "^base64:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "minLength": 51,
            "maxLength": 95
          },
          "viewerTokenSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
