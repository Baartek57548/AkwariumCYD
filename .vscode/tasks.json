{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (esp32dev)",
            "type": "shell",
            "command": "C:\\Users\\Bartek\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "--environment",
                "esp32dev"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Upload (esp32dev)",
            "type": "shell",
            "command": "C:\\Users\\Bartek\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "--environment",
                "esp32dev",
                "--target",
                "upload"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Monitor",
            "type": "shell",
            "command": "C:\\Users\\Bartek\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "device",
                "monitor"
            ],
            "group": "build",
            "isBackground": true
        }
    ]
}
